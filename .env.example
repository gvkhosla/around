# LLM — pick one path.

# Cloud (default): OpenRouter Gemini Flash
OPENROUTER_API_KEY=
# Or OpenAI
OPENAI_API_KEY=
LLM_MODEL=google/gemini-2.5-flash

# Local (Ollama / LM Studio). Wins over cloud if set.
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1
LLM_BASE_URL=
# LLM_MODEL=qwen2.5:14b
LLM_API_KEY=
# Set to 0 if the local server rejects response_format json_object.
LLM_JSON_MODE=

# Optional alphaXiv service key for deeper paper discovery.
# Users can also store their own key in the browser from /settings.
ALPHAXIV_API_KEY=

# Public URL used in bot replies and share links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. Shown on the homepage.
NEXT_PUBLIC_X_HANDLE=

# X bot (`bun run bot`) — needs tweet.read, users.read, tweet.write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
